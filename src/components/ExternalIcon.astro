---
/*
 * Small "↗" indicator placed next to text links that point off-site. The
 * icon is purely visual — aria-hidden so screen readers don't double-announce
 * the destination — and inherits color via currentColor so it matches the
 * link's text in both default and hover states.
 *
 * Size defaults to 11px which sits cleanly next to 13–14px body text in the
 * nav and footer. Pass a different `size` if you need to fit elsewhere.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 11, class: className = "" } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`inline-block align-baseline opacity-70 ${className}`}
  aria-hidden="true"
>
  <path d="M7 7h10v10"></path>
  <path d="m7 17 10-10"></path>
</svg>
