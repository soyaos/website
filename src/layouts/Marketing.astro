---
import "../styles/globals.css";
import {
  locales,
  localeBcp47,
  localeOg,
  defaultLocale,
  stripLocale,
  type Locale,
} from "../i18n/config";
import { getDictionary } from "../i18n/dictionaries";
import LocaleLink from "../components/LocaleLink.astro";
import LocaleSwitcher from "../components/LocaleSwitcher.astro";
import DocsSearch from "../components/DocsSearch.astro";
import ExternalIcon from "../components/ExternalIcon.astro";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /**
   * Locale-less path used to build canonical + hreflang alternates. Defaults
   * to the current URL's pathname with the active locale prefix stripped.
   */
  path?: string;
  schemaType?: "WebSite" | "WebPage" | "CollectionPage" | "TechArticle";
}

const {
  locale,
  title: titleOverride,
  description: descriptionOverride,
  path,
  schemaType = "WebPage",
} =
  Astro.props;

const dict = getDictionary(locale);

const title = titleOverride ?? dict.meta.siteTitle;
const description = descriptionOverride ?? dict.meta.homeDescription;

const localeAgnosticPath = path ?? stripLocale(Astro.url.pathname);
const cleanPath = localeAgnosticPath === "/"
  ? ""
  : localeAgnosticPath.replace(/\/$/, "");

const baseOrigin = "https://soyaos.ai";

const canonical = `${baseOrigin}/${locale}${cleanPath}`;
const markdownAlternate = `${canonical}.md`;

// hreflang map per Google Search Central — keys use BCP-47 standard casing.
const languageAlternates: Record<string, string> = {};
for (const l of locales) {
  languageAlternates[localeBcp47[l]] = `${baseOrigin}/${l}${cleanPath}`;
}
// x-default points at the home-market locale (matches Accept-Language §3.3
// "missing header" branch). Search engines pick this when they have no
// language preference signal.
languageAlternates["x-default"] = `${baseOrigin}/${defaultLocale}${cleanPath}`;

const ogLocale = localeOg[locale];
const ogAlternateLocales = locales
  .filter((l) => l !== locale)
  .map((l) => localeOg[l]);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": schemaType,
  name: "SoyaOS",
  url: baseOrigin,
  headline: title,
  description,
  mainEntityOfPage: canonical,
  inLanguage: localeBcp47[locale],
};
---

<!doctype html>
<html lang={localeBcp47[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#FBFAF5" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={markdownAlternate} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/logo.png" />

    {
      Object.entries(languageAlternates).map(([hreflang, href]) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))
    }

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SoyaOS" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://soyaos.ai/og.png" />
    <meta property="og:locale" content={ogLocale} />
    {
      ogAlternateLocales.map((alt) => (
        <meta property="og:locale:alternate" content={alt} />
      ))
    }

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://soyaos.ai/og.png" />

    {/* Webfonts — Plus Jakarta Sans + IBM Plex Mono + Noto Sans SC fallback.
        Served from the official Google Fonts China mirror (googlefonts.cn) so
        users in mainland China don't hit the previous loli mirror, which is
        no longer reachable. */}
    <link rel="preconnect" href="https://fonts.font.im" />
    <link rel="preconnect" href="https://fonts.gstatic.font.im" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.font.im/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Noto+Sans+SC:wght@400;500;700&display=swap"
    />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col font-sans antialiased">
    <header class="soya-nav sticky top-0 z-40 border-b border-soya-border">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
        <LocaleLink
          href="/"
          locale={locale}
          class="flex items-center gap-2 font-semibold tracking-tight"
        >
          <span class="text-xl leading-none" aria-hidden="true">🫘</span>
          <span class="text-[15px]">SoyaOS</span>
          <span
            class="ml-2 hidden rounded-full bg-soya-skin px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.12em] text-soya-accentDeep sm:inline-block"
            >{dict.common.nav.alpha}</span
          >
        </LocaleLink>
        <nav class="flex items-center gap-5 text-[14px] md:gap-7">
          <LocaleLink href="/editions" locale={locale} class="soya-link">
            {dict.common.nav.editions}
          </LocaleLink>
          <LocaleLink href="/pricing" locale={locale} class="soya-link">
            {dict.common.nav.pricing}
          </LocaleLink>
          <LocaleLink href="/docs" locale={locale} class="soya-link">
            {dict.common.nav.docs}
          </LocaleLink>
          <a
            href="https://github.com/soyaos/soyaos"
            class="soya-link hidden items-center gap-1 sm:inline-flex"
            rel="noopener noreferrer"
            target="_blank"
          >
            {dict.common.nav.github}
            <ExternalIcon />
          </a>
          <DocsSearch locale={locale} />
          <LocaleSwitcher locale={locale} />
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-24 border-t border-soya-border">
      <div
        class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-10 text-[13px] text-soya-mute sm:flex-row sm:items-center sm:justify-between"
      >
        <div class="flex items-center gap-2">
          <span class="text-lg" aria-hidden="true">🫘</span>
          <span class="font-semibold text-soya-ink">SoyaOS</span>
          <span class="opacity-60">· {dict.common.footer.tagline}</span>
        </div>
        <nav class="flex flex-wrap items-center gap-x-5 gap-y-2">
          <LocaleLink href="/editions" locale={locale} class="hover:text-soya-accent">
            {dict.common.footer.editions}
          </LocaleLink>
          <LocaleLink href="/pricing" locale={locale} class="hover:text-soya-accent">
            {dict.common.footer.pricing}
          </LocaleLink>
          <LocaleLink href="/docs" locale={locale} class="hover:text-soya-accent">
            {dict.common.footer.docs}
          </LocaleLink>
          <a
            href="https://github.com/soyaos/soyaos"
            class="inline-flex items-center gap-1 hover:text-soya-accent"
            rel="noopener noreferrer"
            target="_blank"
          >
            {dict.common.footer.github}
            <ExternalIcon />
          </a>
          <a
            href="https://github.com/soyaos/soyaos/blob/main/LICENSE"
            class="inline-flex items-center gap-1 hover:text-soya-accent"
            rel="noopener noreferrer"
            target="_blank"
          >
            {dict.common.footer.license}
            <ExternalIcon />
          </a>
          <span class="opacity-40" aria-hidden="true">·</span>
          <span class="opacity-70">{dict.common.footer.discordSoon}</span>
        </nav>
        <div class="text-[12px] opacity-60">{dict.common.footer.copyright}</div>
      </div>
    </footer>
  </body>
</html>
