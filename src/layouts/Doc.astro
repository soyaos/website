---
import Marketing from "./Marketing.astro";
import DocsSidebar from "../components/DocsSidebar.astro";
import DocsToc from "../components/DocsToc.astro";
import DocsPrevNext from "../components/DocsPrevNext.astro";
import type { Locale } from "../i18n/config";
import type { MarkdownHeading } from "astro";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Locale-less path used to build canonical + hreflang in Marketing. */
  path: string;
  /** Slug of the current doc entry — drives sidebar highlight + prev/next. */
  slug: string;
  /** Headings extracted from the markdown for the right-rail ToC. */
  headings: MarkdownHeading[];
  /** GitHub edit URL (per-locale per-slug) for the "edit this page" link. */
  editHref: string;
  /** Localized label for the edit link — passed in so this layout stays dict-free. */
  editLabel: string;
}

const { locale, title, description, path, slug, headings, editHref, editLabel } =
  Astro.props;
---

<Marketing locale={locale} title={`${title} · SoyaOS`} description={description} path={path} schemaType="TechArticle">
  <div
    class="mx-auto grid w-full max-w-7xl gap-x-10 gap-y-6 px-6 py-10 md:grid-cols-[15rem_1fr] md:py-14 lg:grid-cols-[15rem_minmax(0,1fr)_14rem]"
  >
    <aside class="docs-sidebar-wrap hidden md:block">
      <div class="sticky top-24">
        <DocsSidebar locale={locale} activeSlug={slug} />
      </div>
    </aside>

    <article
      data-pagefind-body
      data-pagefind-meta={`title:${title}`}
      class="docs-article min-w-0"
    >
      <header class="mb-8 border-b border-soya-border pb-6">
        <h1 class="text-[36px] font-bold tracking-[-0.018em] text-soya-ink md:text-[42px]">
          {title}
        </h1>
        <p class="mt-3 text-[16px] leading-[1.55] text-soya-mute">{description}</p>
      </header>

      <slot />

      <p class="mt-12 text-[13px] text-soya-mute/80">
        <a
          href={editHref}
          class="inline-flex items-center gap-1 hover:text-soya-accent"
          rel="noopener noreferrer"
          target="_blank"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
          </svg>
          {editLabel}
        </a>
      </p>

      <DocsPrevNext locale={locale} slug={slug} />
    </article>

    <aside class="docs-toc-wrap hidden lg:block">
      <div class="sticky top-24">
        <DocsToc locale={locale} headings={headings} />
      </div>
    </aside>
  </div>
</Marketing>
