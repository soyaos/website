---
import Marketing from "../layouts/Marketing.astro";

interface Edition {
  name: string;
  cli: string;
  persona: string;
  cost: string;
  status: "alpha" | "planned";
  controlPlane: string;
  dataPlane: string;
  description: string;
}

const editions: Edition[] = [
  {
    name: "Solo",
    cli: "solo",
    persona: "One dev, one laptop.",
    cost: "Free · your hardware",
    status: "alpha",
    controlPlane: "in-process",
    dataPlane: "in-process",
    description:
      "Planet, Moon and Comet collapse into a single process on your machine. No registry, no auth, no network surface — the fastest way to feel SoyaOS.",
  },
  {
    name: "Cluster",
    cli: "cluster",
    persona: "A team + a VPS + intranet devices.",
    cost: "~$0.10 / Comet·hr (est.)",
    status: "planned",
    controlPlane: "self-hosted Planet on your VPS",
    dataPlane: "self-hosted Comets in your LAN / VPC",
    description:
      "One Planet you run, Comets you scale. Auth via shared org token, manifest registry on your S3-compatible bucket. The default shape for a startup engineering team.",
  },
  {
    name: "Cloud",
    cli: "cloud",
    persona: "Register, get an API key, ship.",
    cost: "per-token + per Comet·sec",
    status: "planned",
    controlPlane: "soyaos.ai-managed Planet",
    dataPlane: "soyaos.ai-managed Comets",
    description:
      "We run the Planet and the Comets. You hold an API key. Drop in your own BYOK model key at any time and stop paying us for inference — only for compute.",
  },
  {
    name: "Hybrid",
    cli: "hybrid",
    persona: "SaaS Planet, your Moon.",
    cost: "per-token (control plane only)",
    status: "planned",
    controlPlane: "soyaos.ai-managed Planet",
    dataPlane: "your Comets in your VPC / on-prem",
    description:
      "The orchestration is hosted, the workload stays inside your perimeter. Useful when your data can't leave but you don't want to babysit a control plane.",
  },
  {
    name: "Enterprise Cloud",
    cli: "ent-cloud",
    persona: "Multi-tenant SaaS with SSO and SLA.",
    cost: "contact us",
    status: "planned",
    controlPlane: "dedicated Planet (region pinned)",
    dataPlane: "dedicated Comet pool",
    description:
      "Dedicated regions, SSO/SAML, SOC 2 controls, signed audit log export. Same kernel as Solo — only the operations are different.",
  },
  {
    name: "Enterprise Private",
    cli: "ent-private",
    persona: "On-prem or air-gapped.",
    cost: "annual license",
    status: "planned",
    controlPlane: "customer-operated Planet",
    dataPlane: "customer-operated Comets",
    description:
      "Ship the same binary into a sealed network. Update via signed offline bundles. Tested against banks and labs where outbound is denied by default.",
  },
];

const statusBadge = (s: Edition["status"]) =>
  s === "alpha"
    ? { label: "alpha now", className: "bg-soya-skin text-soya-accentDeep" }
    : { label: "planned", className: "bg-soya-surface text-soya-mute" };
---

<Marketing
  title="Editions · SoyaOS"
  description="SoyaOS ships as one binary in six deployment shapes — Solo, Cluster, Cloud, Hybrid, Enterprise Cloud, Enterprise Private. Pick the one that fits today; switch later without rewriting."
>
  <section class="soya-hero-wash">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
      <span class="soya-pill">Deployment shapes</span>
      <h1
        class="mt-5 text-[40px] font-bold leading-[1.08] tracking-[-0.02em] text-soya-ink md:text-[56px]"
      >
        Six editions. One kernel.
      </h1>
      <p class="mt-5 max-w-2xl text-[17px] leading-[1.6] text-soya-mute md:text-[18px]">
        The <em>edition</em> isn't a different product — it's where the
        Planet (control), Moons (UI / edge) and Comets (workers) run, and who
        runs them. The CLI flag is all that changes.
      </p>
      <pre class="soya-code mt-7 max-w-xl"><code><span class="prompt">$</span>soyaos start --edition <span style="color:#7ba23f">solo</span>     <span class="comment"># or cluster | cloud | hybrid | ...</span></code></pre>
    </div>
  </section>

  {/* Comparison table */}
  <section class="mx-auto max-w-6xl px-6 pb-10">
    <div class="soya-panel overflow-x-auto bg-soya-tofu p-0">
      <table class="min-w-full border-collapse text-[14px]">
        <thead>
          <tr class="bg-soya-panel/80 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-soya-mute">
            <th class="px-5 py-4">Edition</th>
            <th class="px-5 py-4">CLI</th>
            <th class="px-5 py-4">Persona</th>
            <th class="px-5 py-4">Typical cost</th>
            <th class="px-5 py-4">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-soya-border">
          {
            editions.map((e) => {
              const badge = statusBadge(e.status);
              return (
                <tr class="align-top">
                  <td class="px-5 py-4 font-semibold text-soya-ink">
                    {e.name}
                  </td>
                  <td class="px-5 py-4">
                    <code class="rounded bg-soya-panel px-2 py-1 font-mono text-[12.5px] text-soya-ink">
                      {e.cli}
                    </code>
                  </td>
                  <td class="px-5 py-4 text-soya-mute">{e.persona}</td>
                  <td class="px-5 py-4 text-soya-mute">{e.cost}</td>
                  <td class="px-5 py-4">
                    <span
                      class={`inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.08em] ${badge.className}`}
                    >
                      {badge.label}
                    </span>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </section>

  {/* Detail cards */}
  <section class="mx-auto max-w-6xl px-6 py-12">
    <p class="soya-eyebrow">Where things run</p>
    <h2 class="mt-2 text-[28px] font-semibold tracking-tight text-soya-ink md:text-[34px]">
      Control plane vs. data plane, per edition.
    </h2>
    <p class="mt-3 max-w-2xl text-soya-mute">
      Same binary, six split points. The boundary between "you operate it"
      and "we operate it" is the only knob.
    </p>

    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {
        editions.map((e) => {
          const badge = statusBadge(e.status);
          return (
            <article class="soya-card flex h-full flex-col bg-soya-tofu">
              <div class="flex items-center justify-between">
                <h3 class="text-[20px] font-semibold tracking-tight text-soya-ink">
                  {e.name}
                </h3>
                <span
                  class={`inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.08em] ${badge.className}`}
                >
                  {badge.label}
                </span>
              </div>
              <p class="mt-1 font-mono text-[12px] text-soya-accentDeep">
                soyaos start --edition {e.cli}
              </p>
              <p class="mt-4 text-[14px] leading-relaxed text-soya-mute">
                {e.description}
              </p>
              <dl class="mt-5 grid grid-cols-1 gap-3 border-t border-soya-border pt-4 text-[13px] sm:grid-cols-2">
                <div>
                  <dt class="text-[11px] font-semibold uppercase tracking-[0.1em] text-soya-mute/80">
                    Control plane
                  </dt>
                  <dd class="mt-1 text-soya-ink">{e.controlPlane}</dd>
                </div>
                <div>
                  <dt class="text-[11px] font-semibold uppercase tracking-[0.1em] text-soya-mute/80">
                    Data plane
                  </dt>
                  <dd class="mt-1 text-soya-ink">{e.dataPlane}</dd>
                </div>
              </dl>
            </article>
          );
        })
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-20">
    <div
      class="soya-panel flex flex-col items-start justify-between gap-4 bg-soya-panel md:flex-row md:items-center"
    >
      <div>
        <h3 class="text-[20px] font-semibold tracking-tight text-soya-ink">
          Not sure which fits?
        </h3>
        <p class="mt-1 text-[14px] text-soya-mute">
          Start with <code class="font-mono text-soya-accentDeep">solo</code>.
          Graduate to <code class="font-mono text-soya-accentDeep">cluster</code>
          when your laptop fan gets loud. Everything else is the same kernel.
        </p>
      </div>
      <a
        href="https://github.com/soyaos/soyaos/releases"
        class="soya-btn-primary"
        rel="noopener noreferrer"
        target="_blank">Download v0.1</a
      >
    </div>
  </section>
</Marketing>
