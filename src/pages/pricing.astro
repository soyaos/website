---
import Marketing from "../layouts/Marketing.astro";

const future = [
  {
    title: "Cloud edition",
    body: "Per-token + per-second sandbox (gpu·s / vcpu·s) — a transparent cloud LLM provider. Drop in your BYOK key any time and stop paying us for inference; you only pay for the compute we actually scheduled.",
  },
  {
    title: "Enterprise",
    body: "Annual seats + dedicated regions + SSO/SAML + SOC 2. Signed audit log export, offline upgrade bundles, support contracts with response-time SLAs.",
  },
  {
    title: "Core kernel + SoyaPack + CLI",
    body: "Always MIT. The format never gets a paid tier — if it did, the “portable agent” promise would die the moment we tried to monetize it.",
  },
  {
    title: "Forge & Studio",
    body: "Forge (the Agent Factory) and Studio (the local UI) are MIT-licensed and embedded in the same binary as the kernel. They ship together, they version together.",
  },
];
---

<Marketing
  title="Pricing · SoyaOS"
  description="SoyaOS is free during the alpha — MIT-licensed open source, no telemetry, no usage caps. Future cloud edition will be per-token + per-second sandbox; core kernel stays MIT forever."
>
  <section class="soya-hero-wash">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
      <span class="soya-pill">Pricing</span>
      <h1
        class="mt-5 text-[40px] font-bold leading-[1.08] tracking-[-0.02em] text-soya-ink md:text-[56px]"
      >
        Free for everyone during alpha.
      </h1>
      <p class="mt-5 max-w-2xl text-[17px] leading-[1.6] text-soya-mute md:text-[18px]">
        SoyaOS is MIT-licensed open source. We're not running a managed cloud
        yet, so there's no meter, no key, no plan to pick.
      </p>
    </div>
  </section>

  {/* Big alpha banner */}
  <section class="mx-auto max-w-6xl px-6">
    <div
      class="soya-panel grid gap-6 bg-soya-ink text-soya-bg md:grid-cols-[1.4fr_1fr] md:items-center"
    >
      <div>
        <p class="soya-eyebrow text-soya-accent">Alpha</p>
        <h2 class="mt-2 text-[28px] font-semibold tracking-tight md:text-[34px]">
          Free. Forever-MIT core. No phone-home.
        </h2>
        <p class="mt-3 max-w-xl text-[15px] leading-[1.65] text-soya-bg/75">
          Run as many Solo instances as you want, on as many machines as you
          want. No telemetry, no usage caps, no signup. The only limit is
          your hardware.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="https://github.com/soyaos/soyaos/releases"
            class="soya-btn-primary !bg-soya-accent !text-soya-ink hover:!bg-[#f4b73e]"
            rel="noopener noreferrer"
            target="_blank">Download v0.1</a
          >
          <a
            href="https://github.com/soyaos/soyaos"
            class="soya-btn-ghost !bg-transparent !text-soya-bg hover:!border-soya-accent"
            rel="noopener noreferrer"
            target="_blank">Source on GitHub</a
          >
        </div>
      </div>
      <ul class="grid gap-3 text-[14px] text-soya-bg/85">
        <li class="flex items-start gap-2">
          <span class="mt-0.5 text-soya-accent" aria-hidden="true">●</span>
          <span>MIT-licensed — fork, embed, resell.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-0.5 text-soya-accent" aria-hidden="true">●</span>
          <span>No telemetry, no analytics, no remote config.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-0.5 text-soya-accent" aria-hidden="true">●</span>
          <span>Bring your own LLM keys — Claude / GPT / Qwen / Ollama.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-0.5 text-soya-accent" aria-hidden="true">●</span>
          <span>Signed SoyaPacks, capability tokens, audit trail.</span>
        </li>
      </ul>
    </div>
  </section>

  {/* When we monetize */}
  <section class="mx-auto max-w-6xl px-6 py-20">
    <p class="soya-eyebrow">When we monetize</p>
    <h2 class="mt-2 text-[28px] font-semibold tracking-tight text-soya-ink md:text-[34px]">
      The plan after GA.
    </h2>
    <p class="mt-3 max-w-2xl text-soya-mute">
      Nothing below is live or billed yet. We're publishing the intent now so
      you can audit it against what eventually ships.
    </p>

    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {
        future.map((f, i) => (
          <article class="soya-card flex h-full flex-col bg-soya-tofu">
            <span class="soya-eyebrow">
              {String(i + 1).padStart(2, "0")} · Future
            </span>
            <h3 class="mt-3 text-[19px] font-semibold tracking-tight text-soya-ink">
              {f.title}
            </h3>
            <p class="mt-3 text-[14px] leading-relaxed text-soya-mute">
              {f.body}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  {/* FAQ-ish */}
  <section class="mx-auto max-w-6xl px-6 pb-24">
    <div class="soya-panel grid gap-8 bg-soya-panel md:grid-cols-2">
      <div>
        <h3 class="text-[20px] font-semibold tracking-tight text-soya-ink">
          Will the MIT core ever get a paid tier?
        </h3>
        <p class="mt-2 text-[14px] leading-relaxed text-soya-mute">
          No. The kernel, SoyaPack manifest format, CLI, Forge and Studio
          will always be MIT. Paid tiers attach to operations we run on your
          behalf — never to the format or the binary itself.
        </p>
      </div>
      <div>
        <h3 class="text-[20px] font-semibold tracking-tight text-soya-ink">
          Can I commercially deploy SoyaOS today?
        </h3>
        <p class="mt-2 text-[14px] leading-relaxed text-soya-mute">
          Yes — MIT means yes. The alpha label is about API stability, not
          legal restriction. Ship it; just pin a release and read
          <a
            href="https://github.com/soyaos/soyaos/blob/main/CHANGELOG.md"
            class="text-soya-ink underline decoration-soya-accent decoration-2 underline-offset-2 hover:text-soya-accent"
            rel="noopener noreferrer"
            target="_blank">CHANGELOG</a
          > before upgrading.
        </p>
      </div>
    </div>
  </section>
</Marketing>
