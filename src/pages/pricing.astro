---
import Marketing from "../layouts/Marketing.astro";
---

<Marketing title="Pricing · SoyaOS">
  <section class="py-12 text-center">
    <p class="text-xs uppercase tracking-[0.2em] text-soya-accent">Alpha</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">
      Free for everyone.
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-soya-ink/70">
      During the alpha, every edition of SoyaOS is free — including the
      future managed cloud. We'll publish post-GA pricing on this page;
      until then, build whatever you want, no rate limits beyond what your
      hardware imposes.
    </p>
    <a
      href="/docs"
      class="mt-8 inline-flex items-center rounded-md bg-soya-ink px-5 py-2.5 text-sm font-medium text-soya-paper hover:bg-soya-ink/90"
      >Get started</a
    >
  </section>
</Marketing>
