---
/*
 * Root-path fallback for non-Cloudflare hosts and local dev.
 *
 * On production (Cloudflare Pages) public/_worker.js intercepts every request
 * for `/` before the static asset is served, negotiates Accept-Language, and
 * 302-redirects to the right /<locale>. This file is what gets shown if that
 * worker is missing — e.g. running `astro dev` / `astro preview` locally, or
 * deploying to a host that doesn't honor `_worker.js`. The inline script does
 * the equivalent negotiation client-side; the visible fallback covers users
 * with JS disabled.
 *
 * Kept deliberately minimal (no Marketing layout, no nav) so this page never
 * lingers long enough to need full chrome.
 */
const locales = ["zh", "zh-hant", "en"];
const defaultLocale = "zh";
const unmatchedLocale = "en";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>SoyaOS</title>
    <style>
      :root {
        color-scheme: light;
      }
      html,
      body {
        margin: 0;
        background: #fbfaf5;
        color: #2b2419;
        font-family:
          "Plus Jakarta Sans",
          "Inter",
          "Noto Sans SC",
          system-ui,
          -apple-system,
          sans-serif;
      }
      main {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding: 32px;
        text-align: center;
        color: #6b6051;
      }
      .logo {
        font-size: 36px;
      }
      ul {
        list-style: none;
        padding: 0;
        display: flex;
        gap: 16px;
        font-size: 14px;
      }
      a {
        color: #2b2419;
        text-decoration: none;
        border-bottom: 2px solid #e0a52c;
      }
    </style>
    <script
      is:inline
      define:vars={{ locales, defaultLocale, unmatchedLocale }}
    >
      // Client-side mirror of the §3 Accept-Language negotiation.
      const HANT_REGIONS = new Set(["TW", "HK", "MO"]);
      const mapToLocale = (tag) => {
        const lower = tag.toLowerCase().trim();
        if (!lower || lower === "*") return null;
        if (lower === "zh-hant" || lower.startsWith("zh-hant-")) return "zh-hant";
        if (lower === "zh-hans" || lower.startsWith("zh-hans-")) return "zh";
        const [lang, region] = lower.split("-");
        if (lang === "zh" && region && HANT_REGIONS.has(region.toUpperCase()))
          return "zh-hant";
        if (lang === "zh") return "zh";
        if (lang === "en") return "en";
        return null;
      };

      const tags = (navigator.languages && navigator.languages.length
        ? navigator.languages
        : navigator.language
          ? [navigator.language]
          : []
      ).filter(Boolean);

      let pick = null;
      if (tags.length === 0) {
        pick = defaultLocale;
      } else {
        for (const tag of tags) {
          const m = mapToLocale(tag);
          if (m) {
            pick = m;
            break;
          }
        }
        if (!pick) pick = unmatchedLocale;
      }

      if (locales.includes(pick)) {
        const dest = "/" + pick + "/" + window.location.search + window.location.hash;
        window.location.replace(dest);
      }
    </script>
  </head>
  <body>
    <main>
      <span class="logo" aria-hidden="true">🫘</span>
      <p>SoyaOS · choose a language</p>
      <ul>
        <li><a href="/zh/">简体中文</a></li>
        <li><a href="/zh-hant/">繁體中文</a></li>
        <li><a href="/en/">English</a></li>
      </ul>
    </main>
  </body>
</html>
