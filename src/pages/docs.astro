---
// soyaos.ai/docs → docs.soyaos.ai
// Pure meta-refresh + canonical so any static host works without a redirect
// rule. The visible fallback covers users on browsers / readers that disable
// auto-redirects.
const target = "https://docs.soyaos.ai/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex" />
    <title>Redirecting to docs.soyaos.ai · SoyaOS</title>
    <style>
      :root {
        color-scheme: light;
      }
      html,
      body {
        margin: 0;
        background: #fbfaf5;
        color: #2b2419;
        font-family:
          "Plus Jakarta Sans",
          "Inter",
          "Noto Sans SC",
          system-ui,
          -apple-system,
          sans-serif;
      }
      main {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 18px;
        padding: 32px;
        text-align: center;
      }
      .logo {
        font-size: 40px;
      }
      h1 {
        margin: 0;
        font-size: 22px;
        font-weight: 600;
        letter-spacing: -0.01em;
      }
      p {
        margin: 0;
        max-width: 32rem;
        line-height: 1.6;
        color: #6b6051;
        font-size: 14px;
      }
      a.cta {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 12px;
        padding: 12px 22px;
        border-radius: 14px;
        background: #2b2419;
        color: #fbfaf5;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
      }
      a.cta:hover {
        background: #1c1710;
      }
    </style>
  </head>
  <body>
    <main>
      <span class="logo" aria-hidden="true">🫘</span>
      <h1>Redirecting to docs.soyaos.ai</h1>
      <p>
        If your browser doesn't redirect automatically, click the link below.
      </p>
      <a class="cta" href={target} rel="noopener noreferrer">
        Open docs.soyaos.ai
        <span aria-hidden="true">→</span>
      </a>
    </main>
  </body>
</html>
