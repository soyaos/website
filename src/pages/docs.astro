---
// soyaos.ai/docs → docs.soyaos.ai
// Use a meta-refresh + canonical for SSG hosts that don't run redirects.
const target = "https://docs.soyaos.ai/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Redirecting to docs.soyaos.ai</title>
  </head>
  <body>
    <p>
      Redirecting to <a href={target}>{target}</a>.
    </p>
  </body>
</html>
