---
import Marketing from "../../layouts/Marketing.astro";
import { locales, type Locale } from "../../i18n/config";
import { getDictionary } from "../../i18n/dictionaries";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const dict = getDictionary(locale);

// Edition identity (untranslated brand-ish bits) paired with dict.editions.list
// by index — keep the order in sync.
type Status = "alpha" | "planned";
const editionMeta: Array<{ name: string; cli: string; status: Status }> = [
  { name: "Solo", cli: "solo", status: "alpha" },
  { name: "Cluster", cli: "cluster", status: "planned" },
  { name: "Cloud", cli: "cloud", status: "planned" },
  { name: "Hybrid", cli: "hybrid", status: "planned" },
  { name: "Enterprise Cloud", cli: "ent-cloud", status: "planned" },
  { name: "Enterprise Private", cli: "ent-private", status: "planned" },
];

const editions = editionMeta.map((meta, i) => ({ ...meta, ...dict.editions.list[i] }));

const statusBadge = (s: Status) =>
  s === "alpha"
    ? { label: dict.editions.table.badgeAlpha, className: "bg-soya-skin text-soya-accentDeep" }
    : { label: dict.editions.table.badgePlanned, className: "bg-soya-surface text-soya-mute" };
---

<Marketing
  locale={locale}
  title={dict.meta.editionsTitle}
  description={dict.meta.editionsDescription}
  path="/editions"
>
  <section class="soya-hero-wash">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
      <span class="soya-pill">{dict.editions.hero.pill}</span>
      <h1
        class="mt-5 text-[40px] font-bold leading-[1.08] tracking-[-0.02em] text-soya-ink md:text-[56px]"
      >
        {dict.editions.hero.title}
      </h1>
      <p class="mt-5 max-w-2xl text-[17px] leading-[1.6] text-soya-mute md:text-[18px]">
        {dict.editions.hero.subtitleParts.lead}<em>{dict.editions.hero.subtitleParts.em}</em>{dict.editions.hero.subtitleParts.tail}
      </p>
      <pre class="soya-code mt-7 max-w-xl"><code><span class="prompt">$</span>soyaos start --edition <span style="color:#7ba23f">solo</span>     <span class="comment">{dict.editions.hero.codeComment}</span></code></pre>
    </div>
  </section>

  {/* Comparison table */}
  <section class="mx-auto max-w-6xl px-6 pb-10">
    <div class="soya-panel overflow-x-auto bg-soya-tofu p-0">
      <table class="min-w-full border-collapse text-[14px]">
        <thead>
          <tr class="bg-soya-panel/80 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-soya-mute">
            <th class="px-5 py-4">{dict.editions.table.colEdition}</th>
            <th class="px-5 py-4">{dict.editions.table.colCli}</th>
            <th class="px-5 py-4">{dict.editions.table.colPersona}</th>
            <th class="px-5 py-4">{dict.editions.table.colCost}</th>
            <th class="px-5 py-4">{dict.editions.table.colStatus}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-soya-border">
          {
            editions.map((e) => {
              const badge = statusBadge(e.status);
              return (
                <tr class="align-top">
                  <td class="px-5 py-4 font-semibold text-soya-ink">{e.name}</td>
                  <td class="px-5 py-4">
                    <code class="rounded bg-soya-panel px-2 py-1 font-mono text-[12.5px] text-soya-ink">
                      {e.cli}
                    </code>
                  </td>
                  <td class="px-5 py-4 text-soya-mute">{e.persona}</td>
                  <td class="px-5 py-4 text-soya-mute">{e.cost}</td>
                  <td class="px-5 py-4">
                    <span
                      class={`inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.08em] ${badge.className}`}
                    >
                      {badge.label}
                    </span>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </section>

  {/* Detail cards */}
  <section class="mx-auto max-w-6xl px-6 py-12">
    <p class="soya-eyebrow">{dict.editions.detail.eyebrow}</p>
    <h2 class="mt-2 text-[28px] font-semibold tracking-tight text-soya-ink md:text-[34px]">
      {dict.editions.detail.title}
    </h2>
    <p class="mt-3 max-w-2xl text-soya-mute">{dict.editions.detail.intro}</p>

    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {
        editions.map((e) => {
          const badge = statusBadge(e.status);
          return (
            <article class="soya-card flex h-full flex-col bg-soya-tofu">
              <div class="flex items-center justify-between">
                <h3 class="text-[20px] font-semibold tracking-tight text-soya-ink">
                  {e.name}
                </h3>
                <span
                  class={`inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.08em] ${badge.className}`}
                >
                  {badge.label}
                </span>
              </div>
              <p class="mt-1 font-mono text-[12px] text-soya-accentDeep">
                soyaos start --edition {e.cli}
              </p>
              <p class="mt-4 text-[14px] leading-relaxed text-soya-mute">
                {e.description}
              </p>
              <dl class="mt-5 grid grid-cols-1 gap-3 border-t border-soya-border pt-4 text-[13px] sm:grid-cols-2">
                <div>
                  <dt class="text-[11px] font-semibold uppercase tracking-[0.1em] text-soya-mute/80">
                    {dict.editions.detail.controlPlane}
                  </dt>
                  <dd class="mt-1 text-soya-ink">{e.controlPlane}</dd>
                </div>
                <div>
                  <dt class="text-[11px] font-semibold uppercase tracking-[0.1em] text-soya-mute/80">
                    {dict.editions.detail.dataPlane}
                  </dt>
                  <dd class="mt-1 text-soya-ink">{e.dataPlane}</dd>
                </div>
              </dl>
            </article>
          );
        })
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-20">
    <div
      class="soya-panel flex flex-col items-start justify-between gap-4 bg-soya-panel md:flex-row md:items-center"
    >
      <div>
        <h3 class="text-[20px] font-semibold tracking-tight text-soya-ink">
          {dict.editions.closing.title}
        </h3>
        <p class="mt-1 text-[14px] text-soya-mute">
          {dict.editions.closing.bodyParts.lead}<code class="font-mono text-soya-accentDeep">{dict.editions.closing.bodyParts.solo}</code>{dict.editions.closing.bodyParts.mid}<code class="font-mono text-soya-accentDeep">{dict.editions.closing.bodyParts.cluster}</code>{dict.editions.closing.bodyParts.tail}
        </p>
      </div>
      <a
        href="https://github.com/soyaos/soyaos/releases"
        class="soya-btn-primary"
        rel="noopener noreferrer"
        target="_blank">{dict.editions.closing.cta}</a
      >
    </div>
  </section>
</Marketing>
